# Copy this file to .env and paste the real values in. .env is gitignored.
#
# From @BotFather on Telegram: /newbot, then /token
TELEGRAM_BOT_TOKEN=

# Google AI Studio key. The same key research-chain uses.
GEMINI_API_KEY=

# Optional. Defaults shown.
GEMINI_MODEL=gemini-3.8-flash
# How recent a source has to be to be usable, in months.
WINDOW_MONTHS=6
# Only these Telegram user ids may talk to the bot. Comma separated.
# Leave empty on first run - the bot prints the id of whoever messages it.
ALLOWED_USER_IDS=
