# Copy this file to .env and paste the real values in. .env is gitignored.
#
# From @BotFather on Telegram: /newbot, then /token
TELEGRAM_BOT_TOKEN=

# Google AI Studio key. The same key research-chain uses.
GEMINI_API_KEY=

# Optional. Defaults shown.
GEMINI_MODEL=gemini-3.8-flash
# How recent a source has to be to be usable, in months.
WINDOW_MONTHS=6
# Only these Telegram user ids may talk to the bot. Comma separated.
# Leave empty on first run - the bot prints the id of whoever messages it.
ALLOWED_USER_IDS=

# A note scoring this or higher gets drafted. Scores are 0-5 against three
# parameters: a new angle she has not posted on LinkedIn, a named emotion, a
# common misconception corrected.
MIN_SCORE_TO_DRAFT=3

# RSS feeds you trust, comma separated. These can be CITED, because their
# links are the publisher's own. Google News is always searched as well, but
# its links are leads only - they are redirects, not articles.
# e.g. https://www.cosmeticsdesign-asia.com/rss, https://www.bis.gov.in/rss.xml
EXTRA_FEEDS=

# Post length. Her published posts run 429-538 words; she asked on 23 Sept
# 2026 for shorter. The drafting prompt and the style measurement both use
# these numbers, so changing them here changes both.
TARGET_WORDS_MIN=300
TARGET_WORDS_MAX=450
